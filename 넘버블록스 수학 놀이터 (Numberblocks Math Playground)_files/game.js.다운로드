// 1~50 동적 가이드 좌표 생성기 (1자리 수 및 2자리 수 변환)
function getGuideForNumber(num) {
    if (num >= 1 && num <= 9) {
        return baseDigitGuides[num];
    }
    
    if (num >= 10 && num <= 50) {
        const tensDigit = Math.floor(num / 10);
        const unitsDigit = num % 10;

        const tensStrokes = baseDigitGuides[tensDigit] || [];
        const unitsStrokes = baseDigitGuides[unitsDigit] || [];

        // 십의 자리 수치 매핑 (좌측 X: 160 중심, 스케일 0.70)
        const tensMapped = tensStrokes.map(stroke => 
            stroke.map(pt => ({
                x: Math.round((pt.x - 250) * 0.70 + 160),
                y: pt.y
            }))
        );

        // 일의 자리 수치 매핑 (우측 X: 340 중심, 스케일 0.70)
        const unitsMapped = unitsStrokes.map(stroke => 
            stroke.map(pt => ({
                x: Math.round((pt.x - 250) * 0.70 + 340),
                y: pt.y
            }))
        );

        return [...tensMapped, ...unitsMapped];
    }

    return baseDigitGuides[1];
}

