        feedbackLayer.classList.add('hidden');
        checkNextQuizStep();
    }, 2500);
}

// 오답 연출 (즉시 해설 제공 및 다음 문제로 진행)
function handleWrongAnswer(buttonEl) {
    playSound('wrong'); // ❌ 오답 전용 친근한 효과음
    isSetFailed = true; // 세트 내 오답 발생 체크
    
