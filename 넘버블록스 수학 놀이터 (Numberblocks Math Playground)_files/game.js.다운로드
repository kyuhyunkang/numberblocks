if (bgmNextBtn) {
    bgmNextBtn.addEventListener('click', () => {
        initAudio();
        bgmStarted = true;
        if (!soundEnabled) {
            soundEnabled = true;
            if (soundBtn) soundBtn.textContent = '🔊';
            if (volumeSlider) {
                userBgmVolumeRatio = lastUserVolumeRatio > 0 ? lastUserVolumeRatio : 0.5;
                volumeSlider.value = Math.round(userBgmVolumeRatio * 100);
            }
        }
        playNextBgmTrack();
    });
}

