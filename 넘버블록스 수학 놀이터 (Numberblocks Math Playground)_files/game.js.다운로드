// 캔버스의 좌표들을 부드러운 곡선(Bezier) 스타일로 렌더링해주는 도우미 함수
function drawBezierStroke(points, strokeStyle, lineWidth, isDashed = false) {
    if (!points || points.length === 0) return;
    
    ctx.strokeStyle = strokeStyle;
    ctx.lineWidth = lineWidth;
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';
    if (isDashed) {
        ctx.setLineDash([10, 10]);
    } else {
        ctx.setLineDash([]);
    }

    ctx.beginPath();
    ctx.moveTo(points[0].x, points[0].y);

    if (points.length < 3) {
        for (let i = 1; i < points.length; i++) {
            ctx.lineTo(points[i].x, points[i].y);
        }
    } else {
        for (let i = 1; i < points.length - 2; i++) {
            const xc = (points[i].x + points[i + 1].x) / 2;
            const yc = (points[i].y + points[i + 1].y) / 2;
            ctx.quadraticCurveTo(points[i].x, points[i].y, xc, yc);
        }
        const len = points.length;
        ctx.quadraticCurveTo(points[len - 2].x, points[len - 2].y, points[len - 1].x, points[len - 1].y);
    }
    ctx.stroke();
    ctx.setLineDash([]);
}

// 캔버스 가이드라인 렌더링
function drawCanvasTemplate() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    
    const strokes = getGuideForNumber(currentTracingNum);
    
    // 1. 전체 숫자 실루엣 가이드 그리기 (회색 두꺼운 펜선 - 곡선 보간)
    strokes.forEach(stroke => {
        drawBezierStroke(stroke, '#e2e8f0', 45);
    });

    // 2. 이미 그린 과거 완료 획들 렌더링 (연두색)
    completedStrokes.forEach(strokePoints => {
        drawBezierStroke(strokePoints, '#4cd964', 14);
    });

    // 3. 현재 써야 할 활성 획의 중심 점선 가이드 그리기 (하늘색 대시)
    if (currentStrokeIndex < strokes.length) {
        const activeStroke = strokes[currentStrokeIndex];
        drawBezierStroke(activeStroke, '#b5e2ff', 4, true);

        if (nextTargetPointIndex < activeStroke.length) {
            const nextPt = activeStroke[nextTargetPointIndex];
            ctx.fillStyle = '#ff3b30';
            ctx.beginPath();
            ctx.arc(nextPt.x, nextPt.y, 16, 0, Math.PI * 2);
            ctx.fill();

            if (nextTargetPointIndex === 0) {
                ctx.fillStyle = '#ff3b30';
                ctx.font = 'bold 16px Gowun Dodum';
                ctx.fillText('여기서 시작!', nextPt.x - 40, nextPt.y - 25);
            }
        }
    }
}

// 터치펜/손가락 그리기 핸들러 (Pointer Events 활용)
canvas.addEventListener('pointerdown', (e) => {
    if (isSuccessState) return;
    
    isDrawing = true;
    const rect = canvas.getBoundingClientRect();
    
    const scaleX = canvas.width / rect.width;
    const scaleY = canvas.height / rect.height;
    
    const x = (e.clientX - rect.left) * scaleX;
    const y = (e.clientY - rect.top) * scaleY;
    
    drawPoints = [{ x, y }];
    nextTargetPointIndex = 0;
    
    canvas.setPointerCapture(e.pointerId);
    checkTracingPoint(x, y);
});

canvas.addEventListener('pointermove', (e) => {
    if (!isDrawing || isSuccessState) return;
    
    const rect = canvas.getBoundingClientRect();
    const scaleX = canvas.width / rect.width;
    const scaleY = canvas.height / rect.height;
    const x = (e.clientX - rect.left) * scaleX;
    const y = (e.clientY - rect.top) * scaleY;
    
    drawPoints.push({ x, y });
    playSound('draw');

    drawUserPath();
    checkTracingPoint(x, y);
});

canvas.addEventListener('pointerup', (e) => {
    if (!isDrawing) return;
    isDrawing = false;
    canvas.releasePointerCapture(e.pointerId);

    evaluateTracing();
});

function drawUserPath() {
    drawCanvasTemplate();
    
    if (drawPoints.length > 0) {
        drawBezierStroke(drawPoints, '#4cd964', 14);
    }
}

function checkTracingPoint(x, y) {
    const strokes = getGuideForNumber(currentTracingNum);
    if (currentStrokeIndex >= strokes.length) return;

    const activeStroke = strokes[currentStrokeIndex];
    if (nextTargetPointIndex >= activeStroke.length) return;

    const targetPt = activeStroke[nextTargetPointIndex];
    const dist = Math.hypot(x - targetPt.x, y - targetPt.y);

    if (dist < 45) {
        nextTargetPointIndex++;
        drawUserPath();
    }
}

function evaluateTracing() {
    const strokes = getGuideForNumber(currentTracingNum);
    if (currentStrokeIndex >= strokes.length) return;

    const activeStroke = strokes[currentStrokeIndex];

    const passedAllCheckpoints = nextTargetPointIndex >= activeStroke.length;
    
    let reachedEnd = false;
    if (drawPoints.length > 0) {
        const lastDrawPoint = drawPoints[drawPoints.length - 1];
        const lastTargetPoint = activeStroke[activeStroke.length - 1];
        const distToEnd = Math.hypot(lastDrawPoint.x - lastTargetPoint.x, lastDrawPoint.y - lastTargetPoint.y);
        
        if (distToEnd < 70) {
            reachedEnd = true;
        }
    }

    if (passedAllCheckpoints && reachedEnd) {
        completedStrokes.push([...drawPoints]);
        playSound('pop');
        currentStrokeIndex++;
        nextTargetPointIndex = 0;
        drawPoints = [];

        if (currentStrokeIndex >= strokes.length) {
            isDrawing = false;
            successTracing();
        } else {
            drawCanvasTemplate();
        }
    } else {
        drawPoints = [];
        nextTargetPointIndex = 0;
        drawCanvasTemplate();
    }
}

function successTracing() {
    isSuccessState = true;
    playSound('success');
    
    tracingFeedback.classList.remove('hidden');
    
    rewardZone.innerHTML = '';
    const block = createBlockElement(currentTracingNum);
    block.style.position = 'relative';
    block.style.left = '0';
    block.style.top = '0';
    
    rewardZone.appendChild(block);
    block.classList.add('block-bounce');

    setTimeout(() => {
        tracingFeedback.classList.add('hidden');
        isSuccessState = false;
        
        if (currentTracingNum < currentTracingEndNum) {
            currentTracingNum++;
        } else {
            currentTracingNum = currentTracingStartNum;
        }
        initTracing();
    }, 2000);
}

