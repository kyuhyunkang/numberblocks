function createBlockElement(value) {
    const char = document.createElement('div');
    
    // 드래그 앤 드롭을 위한 위치 초기화
    char.style.left = '50px';
    char.style.top = '50px';

    if ((value >= 0 && value <= 50) || value === 100) {
        // 0~50, 100: 원작 캐릭터 이미지 적용
        char.className = 'numberblock-character image-character';
        char.dataset.value = value;

        const img = document.createElement('img');
        img.src = `./resources/imgs/number${value}.png`;
        img.alt = `Numberblock ${value}`;
        img.className = 'numberblock-img';
        img.draggable = false;
        char.appendChild(img);
    } else {
        // 11 이상: 기존 CSS 블록 쌓기 방식 적용
        char.className = 'numberblock-character shape-big-number';
        char.dataset.value = value;

        // 큰 수 뱃지 표시
        const badge = document.createElement('div');
        badge.className = 'big-number-badge';
        badge.textContent = value;
        char.appendChild(badge);

        // 수치만큼 스퀘어 블록 쌓기
        for (let i = 0; i < value; i++) {
            const block = document.createElement('div');
            block.className = 'single-block';
            
            if (value === 100) {
                const row = Math.floor(i / 10);
                const col = i % 10;
                if ((row + col) % 2 === 0) {
                    block.classList.add('chess-salmon');
                } else {
                    block.classList.add('chess-puce');
                }
            } else {
                // 알록달록 무지개 패턴 색상 적용
                const colors = [
                    '#ff3b30', '#ff9500', '#ffcc00', '#4cd964', 
                    '#5ac8fa', '#007aff', '#5856d6', '#ff2d55'
                ];
                block.style.backgroundColor = colors[i % colors.length];
            }
            
            // 맨 위 블록에 넘버블록 얼굴 렌더링
            if (i === value - 1) {
                const face = document.createElement('div');
                face.className = 'block-face';
                
                const eyes = document.createElement('div');
                eyes.className = 'eyes';
                for (let e = 0; e < 2; e++) {
                    const eye = document.createElement('div');
                    eye.className = 'eye';
                    eyes.appendChild(eye);
                }
                
                const mouth = document.createElement('div');
                mouth.className = 'mouth';
                
                face.appendChild(eyes);
                face.appendChild(mouth);
                block.appendChild(face);
            }
            
            char.appendChild(block);
        }
    }

    // 📱 모바일/PC 통합형 더블 탭 및 더블 클릭 분할 이벤트 바인딩 (300ms 타임 필터)
    let lastTapTime = 0;
    char.addEventListener('pointerdown', (e) => {
        const currentTime = new Date().getTime();
        const tapDelay = currentTime - lastTapTime;
        
        if (tapDelay < 300 && tapDelay > 0) {
            e.stopPropagation();
            splitBlock(char);
            lastTapTime = 0; // 격발 후 리셋
        } else {
            lastTapTime = currentTime;
        }
    });

    // 드래그 기능 부여
    makeDraggable(char);

    return char;
}

// ==========================================
// 4. 드래그 앤 드롭 (Pointer Events - 마우스, 터치, 펜 호환)
// ==========================================
let activeDragElement = null;
let dragOffset = { x: 0, y: 0 };

function makeDraggable(el) {
    el.addEventListener('pointerdown', onPointerDown);
}

function onPointerDown(e) {
    // 터치/마우스 이벤트 대상 요소 확보
    activeDragElement = e.currentTarget;
    initAudio(); // 첫 드래그 시 오디오 컨텍스트 활성화

    // 드래그 오프셋 계산
    const rect = activeDragElement.getBoundingClientRect();
    const parentRect = activeDragElement.parentElement.getBoundingClientRect();
    
    dragOffset.x = e.clientX - rect.left;
    dragOffset.y = e.clientY - rect.top;

    activeDragElement.setPointerCapture(e.pointerId);
    activeDragElement.addEventListener('pointermove', onPointerMove);
    activeDragElement.addEventListener('pointerup', onPointerUp);
    
    // 드래그 시작 시 스타일 조절
    activeDragElement.style.transition = 'none';
}

function onPointerMove(e) {
    if (!activeDragElement) return;

    const parent = activeDragElement.parentElement;
    const parentRect = parent.getBoundingClientRect();
    
    // 부모 컨테이너 내의 상대 좌표 계산
    let x = e.clientX - parentRect.left - dragOffset.x;
    let y = e.clientY - parentRect.top - dragOffset.y;

    // 경계선 밖으로 나가지 못하게 제한
    const maxLeft = parentRect.width - activeDragElement.offsetWidth;
    const maxTop = parentRect.height - activeDragElement.offsetHeight;
    
    x = Math.max(0, Math.min(x, maxLeft));
    y = Math.max(0, Math.min(y, maxTop));

    activeDragElement.style.left = `${x}px`;
    activeDragElement.style.top = `${y}px`;
}

function onPointerUp(e) {
    if (!activeDragElement) return;

    activeDragElement.releasePointerCapture(e.pointerId);
    activeDragElement.removeEventListener('pointermove', onPointerMove);
    activeDragElement.removeEventListener('pointerup', onPointerUp);

    activeDragElement.style.transition = 'transform 0.1s ease';

    const currentEl = activeDragElement;
    activeDragElement = null;

    // 드래그 종료 시 충돌 검사 실행
    checkMergeOrDrop(currentEl);
}

// 쪼개기(분해) 로직 - 더블클릭 시 반으로 쪼개거나 1을 떼어냄
function splitBlock(blockEl) {
    const val = parseInt(blockEl.dataset.value);
    if (val <= 1) return; // 1은 더 이상 쪼갤 수 없음

    const parent = blockEl.parentElement;
    const left = parseInt(blockEl.style.left);
    const top = parseInt(blockEl.style.top);

    // 쪼개지는 비율 계산 (최대한 절반에 가깝게 나눔)
    const val1 = Math.floor(val / 2);
    const val2 = val - val1;

    // 기존 블록 제거
    blockEl.remove();
    playSound('split');

