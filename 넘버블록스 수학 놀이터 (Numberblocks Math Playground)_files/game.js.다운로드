// 다음 퀴즈 진행 및 세트 만점 여부 체크 분기 로직
function checkNextQuizStep() {
    const nextStage = currentStage + 1;
    
    // 10문제 단위 고정 세트가 만료되었을 때 (즉, 10, 20, 30, 40, 50번 문제를 방금 풀었을 때)
    if (nextStage > 1 && (nextStage - 1) % 10 === 0) {
        
        // ❌ 단 하나라도 오답이 있었던 경우 (과락 패널티 부여)
        if (isSetFailed) {
            // 실패 모달을 띄우고, 단계 시작 번호(예: 1, 11, 21...)로 롤백 예약
            currentStage = nextStage - 10;
            showFailureModal(correctCountInSet, nextStage - 10);
        }
        // 👑 10문제 모두 맞춘 경우 (승급 성공!)
        else {
            if (nextStage > 50) {
                // 5단계 완전 정복 달성
                currentStage = nextStage; // 51단계 (끝내기 트리거)
                showFinalSuccessModal(50);
            } else {
