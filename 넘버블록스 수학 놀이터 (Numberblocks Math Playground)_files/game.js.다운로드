    soundEnabled = !soundEnabled;
    soundBtn.textContent = soundEnabled ? '🔊' : '🔇';
    if (volumeSlider) {
        if (soundEnabled) {
            userBgmVolumeRatio = lastUserVolumeRatio > 0 ? lastUserVolumeRatio : 0.5;
            volumeSlider.value = Math.round(userBgmVolumeRatio * 100);
            playBgm();
            setBgmVolume(currentTargetBgmVolume);
        } else {
            userBgmVolumeRatio = 0;
            volumeSlider.value = 0;
            pauseBgm();
        }
    }
    initAudio();
});

