        const btn = document.createElement('button');
        btn.className = 'choice-btn';
        btn.textContent = val;
        
        btn.addEventListener('click', (e) => {
            if (hasAnsweredCurrent) return; // 이미 답했으면 무시
            hasAnsweredCurrent = true;
            
            if (val === currentStageData.answer) {
                // 정답인 경우
                handleCorrectAnswer(currentStageData.answer);
            } else {
                // 오답인 경우
                handleWrongAnswer(btn);
            }
        });
        
        quizChoices.appendChild(btn);
    });
}

// 정답 보기 4개 생성 도우미 (정답 1개 + 정답 주변 무작위 오답 3개 셔플)
function generateChoices(answer) {
    const list = new Set();
    list.add(answer);
    
    const upperLimit = Math.max(12, answer + 5);
    
    while (list.size < 4) {
        const offset = Math.floor(Math.random() * 7) - 3; 
        const decoy = answer + offset;
        
        if (decoy > 0 && decoy <= upperLimit && decoy !== answer) {
            list.add(decoy);
        }
    }
    
    return Array.from(list).sort(() => Math.random() - 0.5);
}

// 정답 연출
function handleCorrectAnswer(answerVal) {
    correctCountInSet++; // 세트 내 정답 개수 누적
    
    playSound('success'); // 🎉 정답 팡파르 효과음 출력!
    
    const feedbackLayer = document.getElementById('adventure-success-feedback');
    const blockDisplay = document.getElementById('feedback-block-display');
    const bubbleText = document.getElementById('feedback-bubble-text');
    
    // 매 정답마다 3가지 칭찬 멘트와 음성이 단계 구분 없이 순서대로 번갈아가며 순환 출력!
    const praise = praiseRotationList[currentPraiseIndex];
    
    playGoodJob(praise.audioSrc, praise.gain || 1.0);
    bubbleText.textContent = praise.text;
    
    // 다음 정답 시 다음 칭찬 멘트/음성이 턴제로 순환
    currentPraiseIndex = (currentPraiseIndex + 1) % praiseRotationList.length;
    
    blockDisplay.innerHTML = '';
