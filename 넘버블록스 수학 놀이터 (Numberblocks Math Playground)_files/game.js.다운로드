// ==========================================
// 1. 전역 상태 및 사운드 시스템
// ==========================================
let currentMode = 'home'; // 'home', 'sandbox', 'adventure', 'tracing'
let soundEnabled = true;
let audioCtx = null;

// ==========================================
// 🎵 배경음악 (BGM) 순환 플레이리스트 시스템
// NumberBlocks.mp3 -> NumberBlocks2.mp3 -> NumberBlocks3.mp3 -> NumberBlocks4.mp3 -> 반복
// ==========================================
const bgmPlaylist = [
    './NumberBlocks.mp3',
    './NumberBlocks2.mp3',
    './NumberBlocks3.mp3',
    './NumberBlocks4.mp3'
];
let currentBgmIndex = 0;

function getCurrentBgmGain() {
    // NumberBlocks2.mp3 (index 1) 4.5배 강력 증폭
    // NumberBlocks3.mp3 (index 2) 3.5배 음량 증폭 (NumberBlocks.mp3 수치와 동일 수준으로 감상)
    // NumberBlocks4.mp3 (index 3) 4.0배 음량 강력 증폭 (다른 트랙과 동일하게 시원하고 풍성하게 감상)
    if (currentBgmIndex === 1) return 4.5;
    if (currentBgmIndex === 2) return 3.5;
    if (currentBgmIndex === 3) return 4.0;
    return 1.0;
}

const bgm = new Audio(bgmPlaylist[currentBgmIndex]);
bgm.loop = false; // 곡이 끝나면 자동으로 다음 곡으로 전환하기 위해 false로 설정
let bgmStarted = false;

// 🎵 현재 재생 중인 BGM 트랙 번호 UI 업데이트
function updateBgmTrackDisplay() {
    const bgmTrackInfo = document.getElementById('bgm-track-info');
    const bgmNextBtn = document.getElementById('btn-bgm-next');
    if (bgmTrackInfo) {
        bgmTrackInfo.textContent = `${currentBgmIndex + 1}/${bgmPlaylist.length}`;
    }
    if (bgmNextBtn) {
        bgmNextBtn.title = `다음 곡 재생 (현재 BGM ${currentBgmIndex + 1}/${bgmPlaylist.length})`;
    }
}

// 곡이 종료되면 다음 트랙으로 자동 전환 및 연속 재생
function playNextBgmTrack() {
    currentBgmIndex = (currentBgmIndex + 1) % bgmPlaylist.length;
    bgm.src = bgmPlaylist[currentBgmIndex];
    const targetVol = currentTargetBgmVolume * userBgmVolumeRatio * getCurrentBgmGain();
    bgm.volume = Math.max(0, Math.min(1, targetVol));
    if (soundEnabled && bgmStarted) {
        bgm.play().catch(err => console.log("다음 BGM 곡 재생 오류:", err));
    }
    updateBgmTrackDisplay();
}

bgm.addEventListener('ended', playNextBgmTrack);

// 🎵 3가지 칭찬 멘트 및 음성 턴제 순환 플레이리스트
const praiseRotationList = [
    { audioSrc: './goodjob.mp3', text: '하성아 잘했어! 👑', gain: 1.0 },
    { audioSrc: './goodjob2.mp3', text: '하성아 GoodJob! 💎', gain: 1.5 },
    { audioSrc: './goodjob3.mp3', text: 'Excellent! 하성! 🔥', gain: 1.4 }
];
let currentPraiseIndex = 0;
let goodJobAudio = null;

function playGoodJob(audioSrc = './goodjob.mp3', gainMultiplier = 1.0) {
    if (!soundEnabled) return;
    if (goodJobAudio) {
        goodJobAudio.pause();
        goodJobAudio.currentTime = 0;
    }
    goodJobAudio = new Audio(audioSrc);
    
    // HTML5 Audio 볼륨 설정 (Web Audio CORS 제한으로 인한 무음 방지)
    const effectiveVol = (userBgmVolumeRatio > 0 ? userBgmVolumeRatio : 0.8) * gainMultiplier;
    goodJobAudio.volume = Math.max(0, Math.min(1.0, effectiveVol));
    
    goodJobAudio.play().catch(err => console.log("GoodJob audio error:", err));
}

// 볼륨 모드 설정값 (메뉴: 크게 0.5, 게임 수행: 작게 0.30)
const BGM_VOLUME_HIGH = 0.5;
const BGM_VOLUME_LOW = 0.30;
let currentTargetBgmVolume = BGM_VOLUME_HIGH;
let userBgmVolumeRatio = 0.5; // 슬라이더 기본값 (50%)
let lastUserVolumeRatio = 0.5;
let bgmFadeInterval = null;

function updateEffectiveBgmVolume() {
    if (!soundEnabled || !bgmStarted) return;
    const effectiveVolume = currentTargetBgmVolume * userBgmVolumeRatio * getCurrentBgmGain();
    bgm.volume = Math.max(0, Math.min(1, effectiveVolume));
}

function playBgm() {
    if (!soundEnabled) return;
    const targetVol = currentTargetBgmVolume * userBgmVolumeRatio * getCurrentBgmGain();
    if (!bgmStarted) {
        bgm.volume = Math.max(0, Math.min(1, targetVol));
        bgm.play().then(() => {
            bgmStarted = true;
        }).catch(err => {
            console.log("BGM 재생 대기 (사용자 터치/클릭 필요):", err);
        });
    } else if (bgm.paused) {
        bgm.volume = Math.max(0, Math.min(1, targetVol));
        bgm.play().catch(err => console.log(err));
    }
}

function pauseBgm() {
    bgm.pause();
}

function setBgmVolume(targetVolume, duration = 400) {
    currentTargetBgmVolume = targetVolume;
    if (!soundEnabled) return;
    const targetVol = targetVolume * userBgmVolumeRatio * getCurrentBgmGain();
    if (!bgmStarted) {
        bgm.volume = Math.max(0, Math.min(1, targetVol));
        return;
    }

    if (bgmFadeInterval) clearInterval(bgmFadeInterval);
    const startVolume = bgm.volume;
    const endVolume = Math.max(0, Math.min(1, targetVol));
    const steps = 15;
    const delta = (endVolume - startVolume) / steps;
    let step = 0;

    bgmFadeInterval = setInterval(() => {
        step++;
        const nextVol = startVolume + delta * step;
        bgm.volume = Math.max(0, Math.min(1, nextVol));
        if (step >= steps) {
            bgm.volume = Math.max(0, Math.min(1, endVolume));
            clearInterval(bgmFadeInterval);
            bgmFadeInterval = null;
        }
    }, duration / steps);
}

// 효과음 재생용 Web Audio API 합성 엔진
function initAudio() {
    if (!audioCtx) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    }
    if (sessionStorage.getItem('unlocked') === 'true' && soundEnabled) {
        playBgm();
    }
}

function playSound(type) {
    if (!soundEnabled) return;
    initAudio();

    const doPlay = () => {
        if (!audioCtx) return;
        const now = audioCtx.currentTime;
        
        switch (type) {
            case 'pop': // 블록 소환음
                const osc1 = audioCtx.createOscillator();
                const gain1 = audioCtx.createGain();
                osc1.type = 'sine';
                osc1.frequency.setValueAtTime(150, now);
                osc1.frequency.exponentialRampToValueAtTime(600, now + 0.15);
                gain1.gain.setValueAtTime(0.3, now);
                gain1.gain.exponentialRampToValueAtTime(0.01, now + 0.15);
                osc1.connect(gain1);
                gain1.connect(audioCtx.destination);
                osc1.start(now);
                osc1.stop(now + 0.15);
                break;
                
            case 'merge': // 합체음 (도-미-솔 화음 또는 부드러운 상승음)
                const notes = [261.63, 329.63, 392.00, 523.25]; // C4, E4, G4, C5
                notes.forEach((freq, idx) => {
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(freq, now + idx * 0.05);
                    gain.gain.setValueAtTime(0.15, now + idx * 0.05);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + idx * 0.05 + 0.3);
                    osc.connect(gain);
                    gain.connect(audioCtx.destination);
                    osc.start(now + idx * 0.05);
                    osc.stop(now + idx * 0.05 + 0.3);
                });
                break;

            case 'split': // 쪼개기음 (높은음에서 낮은음으로 쇽!)
                const osc2 = audioCtx.createOscillator();
                const gain2 = audioCtx.createGain();
                osc2.type = 'triangle';
                osc2.frequency.setValueAtTime(800, now);
                osc2.frequency.exponentialRampToValueAtTime(200, now + 0.2);
                gain2.gain.setValueAtTime(0.2, now);
                gain2.gain.exponentialRampToValueAtTime(0.01, now + 0.2);
                osc2.connect(gain2);
                gain2.connect(audioCtx.destination);
                osc2.start(now);
                osc2.stop(now + 0.2);
                break;

            case 'wrong': // 오답 효과음 (친근한 삐빅/띠용 부저음)
                const oscW1 = audioCtx.createOscillator();
                const oscW2 = audioCtx.createOscillator();
                const gainW = audioCtx.createGain();
                oscW1.type = 'sawtooth';
                oscW2.type = 'sine';
                oscW1.frequency.setValueAtTime(220, now);
                oscW1.frequency.setValueAtTime(160, now + 0.12);
                oscW2.frequency.setValueAtTime(210, now);
                oscW2.frequency.setValueAtTime(150, now + 0.12);
                const filterW = audioCtx.createBiquadFilter();
                filterW.type = 'lowpass';
                filterW.frequency.value = 600;
                gainW.gain.setValueAtTime(0.25, now);
                gainW.gain.exponentialRampToValueAtTime(0.01, now + 0.3);
                oscW1.connect(filterW);
                oscW2.connect(filterW);
                filterW.connect(gainW);
                gainW.connect(audioCtx.destination);
                oscW1.start(now);
                oscW2.start(now);
                oscW1.stop(now + 0.3);
                oscW2.stop(now + 0.3);
                break;

            case 'success': // 정답/성공 (트럼펫 느낌의 빰빰!)
                const successNotes = [523.25, 523.25, 523.25, 659.25, 783.99]; // C5, C5, C5, E5, G5
                const durations = [0.1, 0.1, 0.1, 0.15, 0.4];
                let timeAccumulator = 0;
                successNotes.forEach((freq, idx) => {
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    osc.type = 'sawtooth'; // 브라스 톤
                    
                    const filter = audioCtx.createBiquadFilter();
                    filter.type = 'lowpass';
                    filter.frequency.value = 1200;

                    osc.frequency.setValueAtTime(freq, now + timeAccumulator);
                    gain.gain.setValueAtTime(0.18, now + timeAccumulator);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + timeAccumulator + durations[idx]);
                    
                    osc.connect(filter);
                    filter.connect(gain);
                    gain.connect(audioCtx.destination);
                    
                    osc.start(now + timeAccumulator);
                    osc.stop(now + timeAccumulator + durations[idx]);
                    timeAccumulator += durations[idx] - 0.02;
                });
                break;

            case 'draw': // 선 그리기 미세음 (지속적인 연필 사운드 느낌)
                const oscDraw = audioCtx.createOscillator();
                const gainDraw = audioCtx.createGain();
                oscDraw.type = 'sine';
                oscDraw.frequency.setValueAtTime(300, now);
                gainDraw.gain.setValueAtTime(0.03, now);
                gainDraw.gain.exponentialRampToValueAtTime(0.001, now + 0.05);
                oscDraw.connect(gainDraw);
                gainDraw.connect(audioCtx.destination);
                oscDraw.start(now);
                oscDraw.stop(now + 0.05);
                break;
        }
    };

    if (audioCtx.state === 'suspended') {
        audioCtx.resume().then(doPlay).catch(() => doPlay());
    } else {
        doPlay();
    }
}

