// 드래그가 끝났을 때 겹치는 블록끼리 합체하는 로직
function checkMergeOrDrop(draggedEl) {
    const parent = draggedEl.parentElement;
    const blocks = Array.from(parent.querySelectorAll('.numberblock-character'));
    
    const dragVal = parseInt(draggedEl.dataset.value);
    const dragRect = draggedEl.getBoundingClientRect();

    let targetMergeBlock = null;
    let maxOverlapArea = 0;

    blocks.forEach(block => {
        if (block === draggedEl) return;

        const blockRect = block.getBoundingClientRect();
        
        // 겹치는 영역 계산 (AABB 충돌 감지)
        const overlapX = Math.max(0, Math.min(dragRect.right, blockRect.right) - Math.max(dragRect.left, blockRect.left));
        const overlapY = Math.max(0, Math.min(dragRect.bottom, blockRect.bottom) - Math.max(dragRect.top, blockRect.top));
        const overlapArea = overlapX * overlapY;

        // 겹치는 면적이 일정 수준 이상일 때 합체 대상
        if (overlapArea > 800 && overlapArea > maxOverlapArea) {
            maxOverlapArea = overlapArea;
            targetMergeBlock = block;
        }
    });

    if (targetMergeBlock) {
        const targetVal = parseInt(targetMergeBlock.dataset.value);
        const nextVal = dragVal + targetVal;

        if (nextVal <= 100) { // 병합 제한을 100까지로 확장
            const left = parseInt(targetMergeBlock.style.left);
            const top = parseInt(targetMergeBlock.style.top);

            // 기존 블록 둘 다 지우고
            draggedEl.remove();
            targetMergeBlock.remove();

            // 합산된 새 블록 소환
            const mergedEl = createBlockElement(nextVal);
            mergedEl.style.left = `${left}px`;
            mergedEl.style.top = `${top}px`;
            parent.appendChild(mergedEl);
            
            playSound('merge');
            mergedEl.classList.add('block-bounce');
            setTimeout(() => mergedEl.classList.remove('block-bounce'), 400);

            // 만약 퀴즈(모험) 모드라면 정답을 검사
            if (currentMode === 'adventure') {
                checkAdventureGoal();
            }
        } else {
            // 100이 넘어가면 합쳐지지 않고 통 튕기며 경고 토스트 팝업 노출
            bounceBack(draggedEl);
            playSound('split'); // 튕김 효과음
            showToast("100 넘는 숫자를 만들 수 없어요! 🙅");
        }
    } else {
        // 합쳐지지 않은 일반 드롭 시, 퀴즈 모드에서는 영역 검사 수행
        if (currentMode === 'adventure') {
            checkAdventureGoal();
        }
    }
}

function bounceBack(el) {
    // 튕겨나가는 시각 피드백
    el.style.transform = 'scale(0.9)';
    setTimeout(() => {
