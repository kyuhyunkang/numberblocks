function drawKoreanBezierStroke(strokeObj, strokeStyle, lineWidth, isDashed = false) {
    if (!strokeObj || !kCtx) return;
    
    const points = getKoreanStrokePoints(strokeObj);
    const isLinear = getKoreanStrokeIsLinear(strokeObj);
    if (points.length === 0) return;

    kCtx.strokeStyle = strokeStyle;
    kCtx.lineWidth = lineWidth;
    kCtx.lineCap = 'round';
    kCtx.lineJoin = 'round';
    if (isDashed) {
        kCtx.setLineDash([10, 10]);
    } else {
        kCtx.setLineDash([]);
    }

    kCtx.beginPath();
    kCtx.moveTo(points[0].x, points[0].y);

    if (isLinear || points.length < 3) {
        for (let i = 1; i < points.length; i++) {
            kCtx.lineTo(points[i].x, points[i].y);
        }
    } else {
        for (let i = 1; i < points.length - 2; i++) {
            const xc = (points[i].x + points[i + 1].x) / 2;
            const yc = (points[i].y + points[i + 1].y) / 2;
            kCtx.quadraticCurveTo(points[i].x, points[i].y, xc, yc);
        }
        const len = points.length;
        kCtx.quadraticCurveTo(points[len - 2].x, points[len - 2].y, points[len - 1].x, points[len - 1].y);
    }
    kCtx.stroke();
    kCtx.setLineDash([]);
}

function drawKoreanCanvasTemplate() {
    if (!kCtx || !kCanvas) return;
    kCtx.clearRect(0, 0, kCanvas.width, kCanvas.height);
    
    const strokes = baseKoreanGuides[currentKoreanLetter] || baseKoreanGuides[currentKoreanLetter[0]] || baseKoreanGuides['아'];
    
    // 1. 회색 기초 라인
    strokes.forEach(stroke => {
        drawKoreanBezierStroke(stroke, '#e2e8f0', 45);
    });

    // 2. 그려진 획들 (연두색)
    kCompletedStrokes.forEach(strokeObj => {
        drawKoreanBezierStroke(strokeObj, '#4cd964', 14);
    });

    // 3. 현재 활성 획 및 빨간 추적 점
    if (kCurrentStrokeIndex < strokes.length) {
        const activeStroke = strokes[kCurrentStrokeIndex];
        const activePoints = getKoreanStrokePoints(activeStroke);
        drawKoreanBezierStroke(activeStroke, '#af52de', 4, true);

        if (kNextTargetPointIndex < activePoints.length) {
            const nextPt = activePoints[kNextTargetPointIndex];
            kCtx.fillStyle = '#ff3b30';
            kCtx.beginPath();
            kCtx.arc(nextPt.x, nextPt.y, 16, 0, Math.PI * 2);
            kCtx.fill();

            if (kNextTargetPointIndex === 0) {
                kCtx.fillStyle = '#ff3b30';
                kCtx.font = 'bold 16px Gowun Dodum';
                kCtx.fillText('여기서 시작!', nextPt.x - 40, nextPt.y - 25);
            }
        }
    }
}

// 한글 캔버스 터치/마우스 이벤트 리스너 바인딩
function bindKoreanCanvasEvents() {
    const canvasEl = document.getElementById('korean-tracing-canvas');
    if (!canvasEl || canvasEl.dataset.bound === 'true') return;
    canvasEl.dataset.bound = 'true';

    canvasEl.addEventListener('pointerdown', (e) => {
        if (kIsSuccessState) return;
        kIsDrawing = true;
        const rect = canvasEl.getBoundingClientRect();
        const scaleX = canvasEl.width / rect.width;
        const scaleY = canvasEl.height / rect.height;
        const x = (e.clientX - rect.left) * scaleX;
        const y = (e.clientY - rect.top) * scaleY;
        
        kDrawPoints = [{ x, y }];
        kNextTargetPointIndex = 0;
        try {
            canvasEl.setPointerCapture(e.pointerId);
        } catch(err) {}
        checkKoreanTracingPoint(x, y);
    });

    canvasEl.addEventListener('pointermove', (e) => {
        if (!kIsDrawing || kIsSuccessState) return;
        const rect = canvasEl.getBoundingClientRect();
        const scaleX = canvasEl.width / rect.width;
        const scaleY = canvasEl.height / rect.height;
        const x = (e.clientX - rect.left) * scaleX;
        const y = (e.clientY - rect.top) * scaleY;
        
        kDrawPoints.push({ x, y });
        playSound('draw');
        drawKoreanUserPath();
        checkKoreanTracingPoint(x, y);
    });

    canvasEl.addEventListener('pointerup', (e) => {
        if (!kIsDrawing) return;
        kIsDrawing = false;
        try {
            canvasEl.releasePointerCapture(e.pointerId);
        } catch(err) {}
        evaluateKoreanTracing();
    });

    canvasEl.addEventListener('pointercancel', (e) => {
        if (!kIsDrawing) return;
        kIsDrawing = false;
        try {
            canvasEl.releasePointerCapture(e.pointerId);
        } catch(err) {}
        evaluateKoreanTracing();
    });
}

function drawKoreanUserPath() {
    drawKoreanCanvasTemplate();
    if (kDrawPoints.length > 0) {
        drawKoreanBezierStroke(kDrawPoints, '#4cd964', 14);
    }
}

function checkKoreanTracingPoint(x, y) {
    const strokes = baseKoreanGuides[currentKoreanLetter] || baseKoreanGuides['아'];
    if (kCurrentStrokeIndex >= strokes.length) return;

    const activePoints = getKoreanStrokePoints(strokes[kCurrentStrokeIndex]);
    if (kNextTargetPointIndex >= activePoints.length) return;

    const targetPt = activePoints[kNextTargetPointIndex];
    const dist = Math.hypot(x - targetPt.x, y - targetPt.y);

    if (dist < 45) {
        kNextTargetPointIndex++;
        drawKoreanUserPath();
    }
}

function evaluateKoreanTracing() {
    const strokes = baseKoreanGuides[currentKoreanLetter] || baseKoreanGuides['아'];
    if (kCurrentStrokeIndex >= strokes.length) return;

    const activeStroke = strokes[kCurrentStrokeIndex];
    const activePoints = getKoreanStrokePoints(activeStroke);
    const passedAllCheckpoints = kNextTargetPointIndex >= activePoints.length;
    
    let reachedEnd = false;
    if (kDrawPoints.length > 0) {
        const lastDrawPoint = kDrawPoints[kDrawPoints.length - 1];
        const lastTargetPoint = activePoints[activePoints.length - 1];
        const distToEnd = Math.hypot(lastDrawPoint.x - lastTargetPoint.x, lastDrawPoint.y - lastTargetPoint.y);
        
        if (distToEnd < 70) {
            reachedEnd = true;
        }
    }

    if (passedAllCheckpoints && reachedEnd) {
        kCompletedStrokes.push([...kDrawPoints]);
        playSound('pop');
        kCurrentStrokeIndex++;
        kNextTargetPointIndex = 0;
        kDrawPoints = [];

        if (kCurrentStrokeIndex >= strokes.length) {
            kIsDrawing = false;
            successKoreanTracing();
        } else {
            drawKoreanCanvasTemplate();
        }
    } else {
        kDrawPoints = [];
        kNextTargetPointIndex = 0;
        drawKoreanCanvasTemplate();
    }
}

function successKoreanTracing() {
    kIsSuccessState = true;
    playSound('success');
    triggerConfetti(); // 🎉 폭죽 축하 애니메이션 발사!
    
    // 칭찬 음성 & 말풍선 텍스트 턴제 순환 연동 (더하기 빼기 모험과 동일한 칭찬 말풍선 오버레이 출력!)
    const feedbackLayer = document.getElementById('adventure-success-feedback');
    const blockDisplay = document.getElementById('feedback-block-display');
    const bubbleText = document.getElementById('feedback-bubble-text');

    const praise = praiseRotationList[currentPraiseIndex];
    playGoodJob(praise.audioSrc, praise.gain || 1.0);
    currentPraiseIndex = (currentPraiseIndex + 1) % praiseRotationList.length;

    if (feedbackLayer && bubbleText && blockDisplay) {
        bubbleText.textContent = praise.text;
        blockDisplay.innerHTML = '';
        const randomCharVal = Math.floor(Math.random() * 20) + 1; // 1~20 중 무작위 넘버블록스
        const rewardBlock = createBlockElement(randomCharVal);
        blockDisplay.appendChild(rewardBlock);
        feedbackLayer.classList.remove('hidden');
    }

    const feedback = document.getElementById('korean-tracing-feedback');
    const rewardZone = document.getElementById('korean-tracing-reward-zone');
    
    if (feedback) {
        feedback.textContent = `참 잘했어요! '${currentKoreanLetter}' 🎉`;
        feedback.style.animation = 'none';
        void feedback.offsetWidth; // Reflow 강제하여 애니메이션 재트리거
        feedback.style.animation = '';
        feedback.classList.remove('hidden');
    }
    
    // 1~20가지 넘버블록스 원작 캐릭터 중 1개 무작위 선택하여 보상 제공!
    if (rewardZone) {
        rewardZone.innerHTML = '';
        const randomCharVal = Math.floor(Math.random() * 20) + 1;
        const block = createBlockElement(randomCharVal);
        block.style.position = 'relative';
        block.style.left = '0';
        block.style.top = '0';
        
        rewardZone.appendChild(block);
        block.classList.add('block-bounce');
    }

    setTimeout(() => {
        if (feedback) feedback.classList.add('hidden');
        if (feedbackLayer) feedbackLayer.classList.add('hidden');
        kIsSuccessState = false;
        
        const currIdx = currentKoreanStageList.indexOf(currentKoreanLetter);
        if (currIdx >= 0 && currIdx < currentKoreanStageList.length - 1) {
            currentKoreanLetter = currentKoreanStageList[currIdx + 1];
        } else {
            currentKoreanLetter = currentKoreanStageList[0];
        }
        initKoreanTracing();

