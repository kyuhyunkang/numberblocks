function initAdventure() {
    const playzone = document.getElementById('adventure-game-playzone');
    const selector = document.getElementById('adventure-selector-screen');
    if (playzone) playzone.classList.add('hidden');
    if (selector) selector.classList.remove('hidden');
    setBgmVolume(BGM_VOLUME_HIGH); // 메뉴 선택 화면: 크게
}

function switchMode(mode) {
    currentMode = mode;
    
    // 모든 화면 숨김
    document.querySelectorAll('.screen').forEach(scr => scr.classList.add('hidden'));
    
    // 특정 화면 활성화
    const activeScreen = document.getElementById(`screen-${mode}`);
    if (activeScreen) activeScreen.classList.remove('hidden');

    // 홈 이동 버튼 보이기/숨기기
    const btnHome = document.getElementById('btn-home');
    if (mode === 'home') {
        btnHome.classList.add('hidden');
        setBgmVolume(BGM_VOLUME_HIGH); // 메뉴 선택 화면: 크게
    } else {
        btnHome.classList.remove('hidden');
    }

    // 모드 진입 시 초기화 동작
    if (mode === 'sandbox') {
        initSandbox();
        setBgmVolume(BGM_VOLUME_LOW); // 자유 놀이터 (게임 과정): 작게
    } else if (mode === 'adventure') {
        initAdventure();
    } else if (mode === 'tracing') {
        initTracingMode();
        setBgmVolume(BGM_VOLUME_LOW); // 숫자 쓰기 (게임 과정): 작게
    } else if (mode === 'korean-tracing') {
        initKoreanTracingMode();
        setBgmVolume(BGM_VOLUME_LOW); // 한글 쓰기 (게임 과정): 작게
    } else if (mode === 'korean-quiz') {
        initKoreanQuizMode();
        setBgmVolume(BGM_VOLUME_LOW); // 한글 찾기 (게임 과정): 작게
    }
}

