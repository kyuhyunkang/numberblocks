function loadStage(stageNum) {
    currentStage = stageNum;
    hasAnsweredCurrent = false; // 응답 플래그 리셋
    
    // 10문제 세트 시작점(1, 11, 21, 31, 41)이면 중복 집합 리셋
    if ((stageNum - 1) % 10 === 0) {
        usedAdventureKeys.clear();
    }

    // 실시간으로 난이도가 적용된 무작위 문제 생성 (세트 내 중복 없음)
    currentStageData = generateRandomStage();
    
    stageText.textContent = stageNum;
    quizEquation.textContent = `${currentStageData.num1} ${currentStageData.op} ${currentStageData.num2} = ?`;

    // 1. 보조 힌트 이미지 영역 렌더링
    quizVisualZoneNew.innerHTML = '';
    
    const block1 = createBlockElement(currentStageData.num1);
    const block2 = createBlockElement(currentStageData.num2);
    
