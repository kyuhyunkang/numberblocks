// ==========================================
// 🎉 화려한 폭죽 애니메이션 (Confetti Effect)
// ==========================================
const confettiCanvas = document.getElementById('confetti-canvas');
const confettiCtx = confettiCanvas.getContext('2d');

let confettiParticles = [];
let confettiAnimationId = null;
let confettiTimeoutId = null;

// 창 크기 조절 대응
function resizeConfettiCanvas() {
    confettiCanvas.width = window.innerWidth;
    confettiCanvas.height = window.innerHeight;
}
window.addEventListener('resize', resizeConfettiCanvas);
resizeConfettiCanvas();

const CONFETTI_COLORS = ['#ff4d4d', '#ff9f1a', '#fecb2f', '#2ecc71', '#3498db', '#9b59b6', '#e67e22', '#ff73b3'];

class ConfettiParticle {
    constructor() {
        this.x = confettiCanvas.width / 2; // 화면 중앙 하단에서 분수처럼 뿜어냄
        this.y = confettiCanvas.height + 20;
        this.size = Math.random() * 8 + 6;
        
        // 위쪽 방향으로 발사 속도 및 랜덤 퍼짐각도 설정
        const angle = Math.random() * Math.PI / 3 + Math.PI / 3; // 60도 ~ 120도 사이 (위쪽 부채꼴)
        const speed = Math.random() * 12 + 10;
        
        this.vx = Math.cos(angle) * speed * (Math.random() > 0.5 ? 1 : -1);
        this.vy = -Math.sin(angle) * speed;
        
        this.color = CONFETTI_COLORS[Math.floor(Math.random() * CONFETTI_COLORS.length)];
        this.rotation = Math.random() * 360;
        this.rotationSpeed = Math.random() * 4 - 2;
        this.opacity = 1;
        this.gravity = 0.25;
    }
    
    update() {
        this.vy += this.gravity; // 중력 가속도
        this.x += this.vx;
        this.y += this.vy;
        this.rotation += this.rotationSpeed;
        
        // 뿜어져 나간 뒤 하강 단계에서 점진적으로 투명도 감소
        if (this.vy > 0) {
            this.opacity -= 0.015;
        }
    }
    
    draw() {
        confettiCtx.save();
        confettiCtx.translate(this.x, this.y);
        confettiCtx.rotate(this.rotation * Math.PI / 180);
        confettiCtx.globalAlpha = this.opacity;
        confettiCtx.fillStyle = this.color;
        
        // 사각형 리본 모양 파티클
        confettiCtx.fillRect(-this.size / 2, -this.size / 2, this.size, this.size);
        confettiCtx.restore();
    }
}

// 폭죽 발사 트리거 함수
function triggerConfetti() {
    // 기존 애니메이션 루프 종료 및 리셋
    cancelAnimationFrame(confettiAnimationId);
    clearTimeout(confettiTimeoutId);
    confettiCtx.clearRect(0, 0, confettiCanvas.width, confettiCanvas.height);
    confettiParticles = [];
    
    // 폭죽 160개 생성
    for (let i = 0; i < 160; i++) {
        confettiParticles.push(new ConfettiParticle());
    }
    
    animateConfetti();
    
    // 4초 후 서서히 완전 종료
    confettiTimeoutId = setTimeout(() => {
        cancelAnimationFrame(confettiAnimationId);
        confettiCtx.clearRect(0, 0, confettiCanvas.width, confettiCanvas.height);
    }, 4500);
}

function animateConfetti() {
    confettiCtx.clearRect(0, 0, confettiCanvas.width, confettiCanvas.height);
    
    // 입자 업데이트 및 렌더링
    for (let i = confettiParticles.length - 1; i >= 0; i--) {
        const p = confettiParticles[i];
        p.update();
        p.draw();
        
        // 화면을 벗어나거나 투명해진 조각 제거
        if (p.y > confettiCanvas.height + 50 || p.opacity <= 0) {
            confettiParticles.splice(i, 1);
        }
    }
    
    if (confettiParticles.length > 0) {
        confettiAnimationId = requestAnimationFrame(animateConfetti);
    }
}
