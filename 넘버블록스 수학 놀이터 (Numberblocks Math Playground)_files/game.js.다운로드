function initKoreanQuizMode() {
    const selectorScreen = document.getElementById('korean-quiz-selector-screen');
    const gamePlayzone = document.getElementById('korean-quiz-game-playzone');
    
    if (selectorScreen && gamePlayzone) {
        selectorScreen.classList.remove('hidden');
        gamePlayzone.classList.add('hidden');
    }
}

function startKoreanQuizStage(stageNum) {
    currentKoreanQuizStage = stageNum;
    koreanQuizQuestionIndex = 1;
    koreanQuizCorrectCount = 0;

    let targetPool;
    if (currentKoreanQuizStage === 1) {
        targetPool = KOREAN_QUIZ_STAGE1_LETTERS;
    } else if (currentKoreanQuizStage === 2) {
        targetPool = KOREAN_QUIZ_STAGE2_LETTERS;
    } else {
        targetPool = KOREAN_QUIZ_STAGE3_NAMES;
    }

    const shuffledPool = [...targetPool].sort(() => Math.random() - 0.5);
    koreanQuizSetTargets = shuffledPool.slice(0, 10);

    const selectorScreen = document.getElementById('korean-quiz-selector-screen');
    const gamePlayzone = document.getElementById('korean-quiz-game-playzone');
    
    if (selectorScreen && gamePlayzone) {
        selectorScreen.classList.add('hidden');
        gamePlayzone.classList.remove('hidden');
    }

    generateKoreanQuizQuestion();
}

function generateKoreanQuizQuestion() {
    isKoreanQuizEvaluating = false;
    
    // 문제 번호 진행 카운터 업데이트 (문제 1/10 ~ 10/10)
    const stageCounter = document.getElementById('korean-quiz-stage');
    if (stageCounter) {
        stageCounter.textContent = koreanQuizQuestionIndex;
    }

    const nameSlotsContainer = document.getElementById('korean-quiz-name-slots-container');

    if (currentKoreanQuizStage === 3) {
        // 3단계: 이름 찾기 (네모 슬롯 기반)
        currentNameTargetObj = koreanQuizSetTargets[koreanQuizQuestionIndex - 1];
        if (!currentNameTargetObj) {
            currentNameTargetObj = KOREAN_QUIZ_STAGE3_NAMES[Math.floor(Math.random() * KOREAN_QUIZ_STAGE3_NAMES.length)];
        }
        currentKoreanQuizTarget = currentNameTargetObj.name;
        currentNameCharIndex = 0;

        if (nameSlotsContainer) nameSlotsContainer.classList.remove('hidden');

        renderNameSlotsUI();
        generateNameCharChoices();
    } else {
        // 1단계, 2단계: 기존 글자 퀴즈
        if (nameSlotsContainer) nameSlotsContainer.classList.add('hidden');

        currentKoreanQuizTarget = koreanQuizSetTargets[koreanQuizQuestionIndex - 1];
        if (!currentKoreanQuizTarget) {
            const targetPool = (currentKoreanQuizStage === 1) ? KOREAN_QUIZ_STAGE1_LETTERS : KOREAN_QUIZ_STAGE2_LETTERS;
            currentKoreanQuizTarget = targetPool[Math.floor(Math.random() * targetPool.length)];
        }

        let availableWrongPool;
        if (currentKoreanQuizStage === 1) {
            availableWrongPool = KOREAN_QUIZ_STAGE1_LETTERS.filter(l => l !== currentKoreanQuizTarget);
        } else {
            availableWrongPool = KOREAN_QUIZ_ALL_CHOICES_POOL.filter((l, idx, self) => l !== currentKoreanQuizTarget && self.indexOf(l) === idx);
        }

        const wrongChoices = [];
        const poolCopy = [...availableWrongPool];
        while (wrongChoices.length < 3 && poolCopy.length > 0) {
            const rIdx = Math.floor(Math.random() * poolCopy.length);
            wrongChoices.push(poolCopy.splice(rIdx, 1)[0]);
        }

        currentKoreanQuizChoices = [currentKoreanQuizTarget, ...wrongChoices];
        currentKoreanQuizChoices.sort(() => Math.random() - 0.5);

        renderKoreanQuizChoicesUI();
    }

    // 3. UI 및 무작위 넘버블록스 캐릭터(1~50) 렌더링
    const charZone = document.getElementById('korean-quiz-char-zone');
    if (charZone) {
        charZone.innerHTML = '';
        const randVal = Math.floor(Math.random() * 50) + 1; // 1~50 무작위 넘버블록스
        const block = createBlockElement(randVal);
        block.classList.add('block-bounce');
        charZone.appendChild(block);
    }

    // 4. 음성 자동으로 정답 소리 재생
    setTimeout(() => {
        playKoreanQuizTargetAudio();
    }, 350);
}

// 3단계 이름 슬롯 ([ 강 ] [ 하 ] [ 성 ]) UI 렌더링
function renderNameSlotsUI() {
    const slotsContainer = document.getElementById('korean-quiz-name-slots');
    if (!slotsContainer || !currentNameTargetObj) return;

    slotsContainer.innerHTML = '';
    const nameStr = currentNameTargetObj.name;

    for (let i = 0; i < nameStr.length; i++) {
        const slot = document.createElement('div');
        slot.className = 'name-slot-box';
        slot.dataset.index = i;

        if (i < currentNameCharIndex) {
            slot.classList.add('filled');
            slot.textContent = nameStr[i];
        } else if (i === currentNameCharIndex) {
            slot.classList.add('active');
            slot.textContent = '?';
        } else {
            slot.textContent = '_';
        }

        slotsContainer.appendChild(slot);
    }
}

// 3단계 현재 음절에 대한 4지선다 혼동 선택지 생성
function generateNameCharChoices() {
    if (!currentNameTargetObj) return;
    const nameStr = currentNameTargetObj.name;
    const targetChar = nameStr[currentNameCharIndex];

    let distractors = CONFUSING_DISTRACTORS[targetChar] || ['가', '나', '다', '라'];
    distractors = distractors.filter(c => c !== targetChar);

    const wrongChoices = [];
    const poolCopy = [...distractors];
    while (wrongChoices.length < 3 && poolCopy.length > 0) {
        const rIdx = Math.floor(Math.random() * poolCopy.length);
        wrongChoices.push(poolCopy.splice(rIdx, 1)[0]);
    }

    while (wrongChoices.length < 3) {
        const fallbackPool = ['가', '나', '다', '라', '마', '바', '사', '아', '자', '차', '카', '타', '파', '하'];
        const rChar = fallbackPool[Math.floor(Math.random() * fallbackPool.length)];
        if (rChar !== targetChar && !wrongChoices.includes(rChar)) {
            wrongChoices.push(rChar);
        }
    }

    currentKoreanQuizChoices = [targetChar, ...wrongChoices];
    currentKoreanQuizChoices.sort(() => Math.random() - 0.5);

    renderKoreanQuizChoicesUI();
}

function renderKoreanQuizChoicesUI() {
    const container = document.getElementById('korean-quiz-choices');
    if (!container) return;

    container.innerHTML = '';
    currentKoreanQuizChoices.forEach(letter => {
        const btn = document.createElement('button');
        btn.className = 'korean-choice-btn';
        btn.textContent = letter;
        btn.onclick = () => onSelectKoreanQuizChoice(letter, btn);
        container.appendChild(btn);
    });
}

function playKoreanQuizTargetAudio() {
    if (currentKoreanQuizStage === 3 && currentNameTargetObj) {
        playNameAudio(currentNameTargetObj);
    } else if (currentKoreanQuizTarget) {
        playKoreanAudio(currentKoreanQuizTarget);
    }
}

function playNameAudio(nameObj) {
    if (!soundEnabled || !nameObj) return;
    const nameStr = typeof nameObj === 'string' ? nameObj : nameObj.name;
    const audioPath = (typeof nameObj === 'object' && nameObj.audio) 
        ? nameObj.audio 
        : `./한글/name/${nameStr}.mp3`;

    const audio = new Audio(audioPath);
    const vol = (userBgmVolumeRatio > 0 ? userBgmVolumeRatio : 0.8);
    audio.volume = Math.max(0, Math.min(1.0, vol * 1.3));
    audio.play().catch(err => {
        console.log("Name audio error, trying fallback:", err);
        if (nameStr === '정하루') {
            const altAudio = new Audio('./한글/name/전하루.mp3');
            altAudio.volume = Math.max(0, Math.min(1.0, vol * 1.3));
            altAudio.play().catch(e => console.log("Alt audio error:", e));
        }
    });
}

function onSelectKoreanQuizChoice(selectedLetter, btnEl) {
    if (isKoreanQuizEvaluating) return;

    if (currentKoreanQuizStage === 3) {
        // 3단계: 이름 맞추기 단계별 처리
        const nameStr = currentNameTargetObj.name;
        const targetChar = nameStr[currentNameCharIndex];

        if (selectedLetter === targetChar) {
            // 🎉 한 글자 정답!
            btnEl.classList.add('correct-choice');
            playSound('success');

            // 해당 슬롯 박스 갱신 (filled 및 완성 연출)
            currentNameCharIndex++;
            renderNameSlotsUI();

            if (currentNameCharIndex < nameStr.length) {
                // 1글자 정답 성공! -> "참 잘했어요!" 토스트 피드백 후 다음 글자 선택지 생성
                showToastFeedback(`참 잘했어요! '${targetChar}' 🎉`);
                setTimeout(() => {
                    btnEl.classList.remove('correct-choice');
                    generateNameCharChoices();
                }, 750);
            } else {
                // 🎉 이름 전체 완공! (예: 강하성 3글자 모두 완성)
                isKoreanQuizEvaluating = true;
                koreanQuizCorrectCount++;

                const feedbackLayer = document.getElementById('adventure-success-feedback');
                const blockDisplay = document.getElementById('feedback-block-display');
                const bubbleText = document.getElementById('feedback-bubble-text');

                // 칭찬 음성 & 말풍선 (예: Excellent! 강하성! 🔥)
                const praise = praiseRotationList[currentPraiseIndex];
                playGoodJob(praise.audioSrc, praise.gain || 1.0);
                currentPraiseIndex = (currentPraiseIndex + 1) % praiseRotationList.length;

                if (feedbackLayer && bubbleText && blockDisplay) {
                    bubbleText.textContent = `Excellent! ${nameStr}! 🔥`;
                    blockDisplay.innerHTML = '';
                    const randomCharVal = Math.floor(Math.random() * 20) + 1;
                    const rewardBlock = createBlockElement(randomCharVal);
                    blockDisplay.appendChild(rewardBlock);
                    feedbackLayer.classList.remove('hidden');
                }

                triggerConfetti();

                setTimeout(() => {
                    btnEl.classList.remove('correct-choice');
                    if (feedbackLayer) feedbackLayer.classList.add('hidden');
                    advanceKoreanQuizNextStep();
                }, 2200);
            }
        } else {
            // ❌ 오답 선택!
            btnEl.classList.add('wrong-choice');
            playSound('wrong');

            setTimeout(() => {
                btnEl.classList.remove('wrong-choice');
            }, 1000);
        }
    } else {
        // 1단계, 2단계 기존 글자 퀴즈 로직
        isKoreanQuizEvaluating = true;
        const feedbackLayer = document.getElementById('adventure-success-feedback');
        const blockDisplay = document.getElementById('feedback-block-display');
        const bubbleText = document.getElementById('feedback-bubble-text');

        if (selectedLetter === currentKoreanQuizTarget) {
            // 🎉 정답 선택!
            koreanQuizCorrectCount++;
            btnEl.classList.add('correct-choice');
            playSound('success');
            
            // 칭찬 음성 & 말풍선 텍스트 턴제 순환 연동 (더하기 빼기 모험과 동일한 칭찬 말풍선 오버레이 출력!)
            const praise = praiseRotationList[currentPraiseIndex];
            playGoodJob(praise.audioSrc, praise.gain || 1.0);
            currentPraiseIndex = (currentPraiseIndex + 1) % praiseRotationList.length;

            if (feedbackLayer && bubbleText && blockDisplay) {
                bubbleText.textContent = praise.text;
                blockDisplay.innerHTML = '';
                const randomCharVal = Math.floor(Math.random() * 20) + 1; // 1~20 중 무작위 넘버블록스
                const rewardBlock = createBlockElement(randomCharVal);
                blockDisplay.appendChild(rewardBlock);
                feedbackLayer.classList.remove('hidden');
            }

            triggerConfetti();

            // 2.2초 후 말풍선 레이어 닫고 다음 문제 진행
            setTimeout(() => {
                btnEl.classList.remove('correct-choice');
                if (feedbackLayer) feedbackLayer.classList.add('hidden');
                advanceKoreanQuizNextStep();
            }, 2200);
        } else {
            // ❌ 오답 선택! (더하기 빼기 모험과 동일하게 틀린 피드백 주고 다음 문제 진행)
            btnEl.classList.add('wrong-choice');
            playSound('wrong');

            if (feedbackLayer && bubbleText && blockDisplay) {
                bubbleText.textContent = `아쉬워요! 정답은 '${currentKoreanQuizTarget}'입니다. 😢`;
                blockDisplay.innerHTML = '';
                const randomCharVal = Math.floor(Math.random() * 20) + 1;
                const sadBlock = createBlockElement(randomCharVal);
                sadBlock.classList.add('sad-face'); // 😢 슬픈 표정 블록!
                blockDisplay.appendChild(sadBlock);
                feedbackLayer.classList.remove('hidden');
            }

            setTimeout(() => {
                btnEl.classList.remove('wrong-choice');
                if (feedbackLayer) feedbackLayer.classList.add('hidden');
                advanceKoreanQuizNextStep();
            }, 2200);
        }
    }
}

function showToastFeedback(msg) {
    const feedback = document.getElementById('korean-tracing-feedback');
    if (feedback) {
        feedback.textContent = msg;
        feedback.style.animation = 'none';
        void feedback.offsetWidth;
        feedback.style.animation = '';
        feedback.classList.remove('hidden');
        setTimeout(() => {
            feedback.classList.add('hidden');
        }, 1200);
    }
}

function advanceKoreanQuizNextStep() {
    koreanQuizQuestionIndex++;
    if (koreanQuizQuestionIndex <= 10) {
        generateKoreanQuizQuestion();
    } else {
        // 🎉 10문항 세트 완료! (10문제 다 맞추면 퍼펙트 완공 모달, 1개라도 틀리면 다시 도전 모달)
        showKoreanQuizResultModal();
    }
}

function showKoreanQuizResultModal() {
    const modal = document.getElementById('modal-success');
    const rewardCharZone = document.getElementById('modal-reward-character');
    const modalText = document.getElementById('modal-text');
    const modalTitle = document.getElementById('modal-title');
    const nextBtn = document.getElementById('modal-next-btn');

    rewardCharZone.innerHTML = '';

    if (koreanQuizCorrectCount === 10) {
        // 👑 10문제 모두 맞춘 경우 (퍼펙트 완공!)
        playSound('success');
        triggerConfetti(); // 🎉 폭죽 발사!

        nextBtn.textContent = '단계 선택으로 🏠';
        nextBtn.style.backgroundColor = '#4cd964';

        const randomCharVal = Math.floor(Math.random() * 20) + 1;
        const rewardChar = createBlockElement(randomCharVal);
        rewardCharZone.appendChild(rewardChar);

        modalTitle.textContent = '🎉 10문제 완공! 🎉';
        modalText.innerHTML = `축하합니다!<br>10문제를 모두 완벽하게 맞췄어요!<br><strong>하성이가 정말 대단해요! 👍</strong>`;

        nextBtn.onclick = () => {
            modal.classList.add('hidden');
            nextBtn.style.backgroundColor = '';
            initKoreanQuizMode();
        };
    } else {
        // 🥺 1개라도 틀린 경우 (다시 도전해 봐요!)
        playSound('split');

        nextBtn.textContent = '다시 시도하기 🔄';
        nextBtn.style.backgroundColor = '#4cd964';

        const randomCharVal = Math.floor(Math.random() * 20) + 1;
        const sadChar = createBlockElement(randomCharVal);
        sadChar.classList.add('sad-face'); // 😢 슬픈 표정 블록
        rewardCharZone.appendChild(sadChar);

        modalTitle.textContent = '🥺 다시 도전해 봐요! 🥺';
        modalText.innerHTML = `10문항 중 <strong>${koreanQuizCorrectCount}개</strong>를 맞췄어요.<br>10문제를 다 맞아야 다음 단계로 갈 수 있어요.<br><strong>다시 시도해 보세요! 🔄</strong>`;

        nextBtn.onclick = () => {
            modal.classList.add('hidden');
            nextBtn.style.backgroundColor = '';
            startKoreanQuizStage(currentKoreanQuizStage); // 현재 단계 10문제 다시 시작
        };
    }

    modal.classList.remove('hidden');
