let isSetFailed = false;     // 현재 10문항 세트 내 오답 발생 여부
let hasAnsweredCurrent = false; // 현재 문제 응답 여부 (중복방지)
let usedAdventureKeys = new Set(); // 10문제 세트 내 중복 수식 방지용 집합

// 단계별 난이도가 뚜렷하게 반영되는 무작위 덧셈/뺄셈 단일 수식 생성기 (음수/0 방지)
function generateSingleRandomStage() {
    const isAddition = Math.random() < 0.5;
    let num1, num2, op, answer;
    
    let minLimit = 2;
    let maxLimit = 10;
    
    if (currentStage > 40) {
        minLimit = 41;
        maxLimit = 50;
    } else if (currentStage > 30) {
        minLimit = 31;
        maxLimit = 40;
    } else if (currentStage > 20) {
        minLimit = 21;
        maxLimit = 30;
    } else if (currentStage > 10) {
        minLimit = 11;
        maxLimit = 20;
    }
    
    if (isAddition) {
        op = '+';
        answer = Math.floor(Math.random() * (maxLimit - minLimit + 1)) + minLimit; 
        num1 = Math.floor(Math.random() * (answer - 1)) + 1;
        num2 = answer - num1;
    } else {
        op = '-';
        num1 = Math.floor(Math.random() * (maxLimit - minLimit + 1)) + minLimit;
        num2 = Math.floor(Math.random() * (num1 - 1)) + 1; 
        answer = num1 - num2;
    }
    
    return { num1, op, num2, answer };
}

// 10문제 세트 내에서 수식이 중복되지 않도록 선출
function generateRandomStage() {
    let stageObj;
    let key;
    let attempts = 0;

    do {
        stageObj = generateSingleRandomStage();
        key = `${stageObj.num1}${stageObj.op}${stageObj.num2}`;
        attempts++;
    } while (usedAdventureKeys.has(key) && attempts < 100);

    usedAdventureKeys.add(key);
    return stageObj;
}

function initAdventure() {
    currentStage = 1;
