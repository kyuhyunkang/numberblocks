// 8. 보호자 비밀번호 잠금 처리 (0608)
// ==========================================
let inputPin = "";

function initLockScreen() {
    const lockScreen = document.getElementById('screen-lock');
    const lockBox = document.querySelector('.lock-box');
    const lockErrorMsg = document.getElementById('lock-error-msg');
    const dots = document.querySelectorAll('.password-display .dot');

    // 이미 세션 내에서 잠금 해제했었다면 즉시 잠금해제 상태 적용
    if (sessionStorage.getItem('unlocked') === 'true') {
        lockScreen.classList.add('unlocked');
    }

    // 잠금 화면 내의 키패드 버튼 이벤트 연결
    document.querySelectorAll('.lock-screen .key-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
            const key = btn.dataset.key;
            initAudio(); // 첫 터치 시 사운드 컨텍스트 활성화

            if (key === 'C') {
                inputPin = "";
                updateDots();
                playSound('split');
            } else if (key === 'OK') {
                submitPin();
            } else {
                if (inputPin.length < 4) {
                    inputPin += key;
                    updateDots();
                    playSound('pop');

                    // 4자리가 차면 자동으로 제출 검사
                    if (inputPin.length === 4) {
                        setTimeout(submitPin, 150);
                    }
                }
            }
        });
    });

    function updateDots() {
        dots.forEach((dot, idx) => {
            if (idx < inputPin.length) {
                dot.classList.add('filled');
            } else {
                dot.classList.remove('filled');
            }
        });
        lockErrorMsg.classList.add('hidden');
    }

    function submitPin() {
        if (inputPin === "0608") {
            playSound('success');
            lockScreen.classList.add('unlocked');
            sessionStorage.setItem('unlocked', 'true');
            playBgm(); // 비번 입력 후 게임 시작 시 BGM 재생!
            setBgmVolume(BGM_VOLUME_HIGH); // 메뉴(홈) 화면이므로 소리 크게
        } else {
            playSound('split');
            lockErrorMsg.classList.remove('hidden');
            
            // 비밀번호 틀림 셰이크 애니메이션 효과
            lockBox.classList.add('shake-anim');
            setTimeout(() => {
                lockBox.classList.remove('shake-anim');
            }, 300);

            inputPin = "";
            updateDots();
        }
    }
}

