// 한글 음성 파일 재생 함수 (./한글/{letter}.mp3)
function playKoreanAudio(letter) {
    if (!soundEnabled) return;
    const audio = new Audio(`./한글/${letter}.mp3`);
    const vol = (userBgmVolumeRatio > 0 ? userBgmVolumeRatio : 0.8);
    audio.volume = Math.max(0, Math.min(1.0, vol));
    audio.play().catch(err => console.log("한글 음성 재생 오류:", err));
}

// 이름 음성 재생
function playNameAudio(nameObj) {
    if (!soundEnabled) return;
    const audio = new Audio(nameObj.audio);
    const vol = (userBgmVolumeRatio > 0 ? userBgmVolumeRatio : 0.8);
    audio.volume = Math.max(0, Math.min(1.0, vol));
    audio.play().catch(err => console.log("이름 음성 재생 오류:", err));
}

let kIsDrawing = false;
let kIsSuccessState = false;
let kDrawPoints = [];
let kCompletedStrokes = [];
let kCurrentStrokeIndex = 0;
let kNextTargetPointIndex = 0;

let kCanvas = null;
let kCtx = null;

function getKoreanStrokePoints(strokeObj) {
    if (Array.isArray(strokeObj)) return strokeObj;
    if (strokeObj && strokeObj.points) return strokeObj.points;
    return [];
}

function getKoreanStrokeIsLinear(strokeObj) {
    if (strokeObj && strokeObj.isLinear) return true;
    return false;
}

function initKoreanTracingMode() {
    const selectorScreen = document.getElementById('korean-tracing-selector-screen');
    const gamePlayzone = document.getElementById('korean-tracing-game-playzone');
    
    if (selectorScreen && gamePlayzone) {
        selectorScreen.classList.remove('hidden');
        gamePlayzone.classList.add('hidden');
    }
}

function startKoreanTracingStage(stageNum) {
    currentKoreanTracingStage = stageNum;

    if (stageNum === 1) {
        currentKoreanStageList = KOREAN_STAGE_1;
        currentKoreanLetter = currentKoreanStageList[0];
    } else if (stageNum === 2) {
        currentKoreanStageList = KOREAN_STAGE_2;
        currentKoreanLetter = currentKoreanStageList[0];
    } else {
        // 3단계: 이름 쓰기
        currentTracingNameObj = KOREAN_STAGE_3_NAMES[0];
        currentTracingNameCharIndex = 0;
        currentKoreanLetter = currentTracingNameObj.name[0];
    }

    const selectorScreen = document.getElementById('korean-tracing-selector-screen');
    const gamePlayzone = document.getElementById('korean-tracing-game-playzone');
    
    if (selectorScreen && gamePlayzone) {
        selectorScreen.classList.add('hidden');
        gamePlayzone.classList.remove('hidden');
    }

    renderKoreanLetterSelector();
    initKoreanTracing();
    bindKoreanCanvasEvents();

    // 음성 자동 재생
    setTimeout(() => {
        if (currentKoreanTracingStage === 3 && currentTracingNameObj) {
            playNameAudio(currentTracingNameObj);
        } else {
            playKoreanAudio(currentKoreanLetter);
        }
    }, 250);
}

